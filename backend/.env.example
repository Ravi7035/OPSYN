GEMINI_TIMEOUT_S=60.0
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=4096
# Production: public URL of the deployed frontend (comma-separated if more
# than one), e.g. FRONTEND_URL=https://opsyn.vercel.app. Empty = localhost
# browser access only. The hosting platform provides $PORT for uvicorn;
# nothing to configure here for the port.
FRONTEND_URL=
