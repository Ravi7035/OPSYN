HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sre-organizational-memory
REASONING_MODEL=deterministic
GROQ_API_KEY=
